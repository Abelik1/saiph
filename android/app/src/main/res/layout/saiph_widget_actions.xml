<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/saiph_widget_background"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout
        android:id="@+id/saiph_actions_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saiph"
                android:textColor="@color/saiph_text"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/saiph_actions_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/saiph_muted"
                android:textSize="13sp" />
        </LinearLayout>
        <Button
            android:background="@drawable/saiph_widget_button"
            android:textAllCaps="false"
            android:textColor="@color/saiph_on_tonal"
            android:id="@+id/saiph_actions_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="88dp"
            android:text="Pause" />
    </LinearLayout>
    <TextView
        android:id="@+id/saiph_actions_devices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:textColor="@color/saiph_muted"
        android:textSize="12sp"
        android:visibility="gone" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <Button
            android:background="@drawable/saiph_widget_button"
            android:textAllCaps="false"
            android:textColor="@color/saiph_on_tonal"
            android:id="@+id/saiph_actions_ring"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Ring computer" />
        <Button
            android:background="@drawable/saiph_widget_button"
            android:textAllCaps="false"
            android:textColor="@color/saiph_on_tonal"
            android:id="@+id/saiph_actions_photo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Photo" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:background="@drawable/saiph_widget_button"
            android:textAllCaps="false"
            android:textColor="@color/saiph_on_tonal"
            android:id="@+id/saiph_actions_sketch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Sketch" />
        <Button
            android:background="@drawable/saiph_widget_button"
            android:textAllCaps="false"
            android:textColor="@color/saiph_on_tonal"
            android:id="@+id/saiph_actions_remote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Remote" />
    </LinearLayout>
</LinearLayout>
