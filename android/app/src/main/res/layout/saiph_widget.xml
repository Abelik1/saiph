<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/saiph_widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">
    <LinearLayout
        android:id="@+id/saiph_widget_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saiph"
            android:textColor="@color/saiph_text"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/saiph_widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/saiph_muted"
            android:textSize="13sp" />
    </LinearLayout>
    <Button
            android:background="@drawable/saiph_widget_button"
            android:textAllCaps="false"
            android:textColor="@color/saiph_on_tonal"
        android:id="@+id/saiph_widget_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="88dp"
        android:text="Pause" />
</LinearLayout>
