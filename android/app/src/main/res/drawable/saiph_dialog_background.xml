<!-- The dialog surface: the app's night card, rounded, with a hairline. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="16dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/saiph_card" />
        <stroke android:width="1dp" android:color="@color/saiph_line_strong" />
        <corners android:radius="24dp" />
    </shape>
</inset>
