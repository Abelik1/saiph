<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--============-->
    <!-- Base Theme -->
    <!--============-->
    <!-- Saiph is dark only, in the desktop's night, cyan and violet. System dialogs,
         switches and the window behind every screen follow it. -->
    <style name="Base.Theme.Sefirah" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/saiph_accent</item>
        <item name="colorOnPrimary">@color/saiph_on_accent</item>
        <item name="colorSecondary">@color/saiph_on_tonal</item>
        <item name="colorTertiary">@color/saiph_violet</item>
        <item name="android:colorBackground">@color/saiph_background</item>
        <item name="colorSurface">@color/saiph_card</item>
        <item name="colorOnSurface">@color/saiph_text</item>
        <item name="colorSurfaceContainerHigh">@color/saiph_card</item>
        <item name="colorOutline">@color/saiph_line_strong</item>
        <item name="android:windowBackground">@color/saiph_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/saiph_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:alertDialogTheme">@style/Theme.Saiph.Dialog</item>
        <item name="alertDialogTheme">@style/Theme.Saiph.Dialog</item>
    </style>

    <!-- Dialogs: a night card with a hairline, cyan actions in sentence case. -->
    <style name="Theme.Saiph.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/saiph_dialog_background</item>
        <item name="android:colorBackground">@color/saiph_card</item>
        <item name="android:colorAccent">@color/saiph_accent</item>
        <item name="android:textColorPrimary">@color/saiph_text</item>
        <item name="android:textColorSecondary">@color/saiph_muted</item>
        <item name="android:buttonBarButtonStyle">@style/Saiph.DialogButton</item>
    </style>
    <style name="Saiph.DialogButton" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/saiph_on_tonal</item>
        <item name="android:textSize">15sp</item>
    </style>


    <!--== Default Theme ==-->
    <style name="Theme.Sefirah" parent="Base.Theme.Sefirah" />

    <!--== Splash Theme ==-->
    <style name="Theme.Sefirah.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenBackground">@color/saiph_background</item>
        <item name="postSplashScreenTheme">@style/Theme.Sefirah</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <style name="Theme.Sefirah.Translucent" parent="Base.Theme.Sefirah">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>
</resources>