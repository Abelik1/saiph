<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- restic runs as a child process from nativeLibraryDir, which is mounted
         executable only when the libraries are extracted from the APK; without
         this, exec() fails with ENOEXEC. Declared here so AAR consumers inherit
         it and cannot silently get a broken build. -->
    <application android:extractNativeLibs="true" tools:targetApi="23" />
</manifest>
